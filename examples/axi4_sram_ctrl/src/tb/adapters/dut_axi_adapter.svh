class dut_axi_adapter extends uvm_component;
  `uvm_component_utils(dut_axi_adapter)
  axi4_master_pkg::axi4_master_agent vip_agent;
  axi4_master_pkg::axi4_master_agent_config vip_cfg;
  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction
  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    vip_cfg = axi4_master_pkg::axi4_master_agent_config::type_id::create("vip_cfg");
    vip_cfg.is_active = UVM_ACTIVE;   // the VIP plays the master; the DUT is the slave (binding: vip_agent_role master)
    vip_cfg.has_coverage = 1;
    vip_cfg.master_min_addr_range(0, 0);
    vip_cfg.master_max_addr_range(0, '1);
    vip_agent = axi4_master_pkg::axi4_master_agent::type_id::create("vip_agent", this);
    vip_agent.axi4_master_agent_cfg_h = vip_cfg;
  endfunction
  // Drive one transaction through the VIP master and return when the VIP has finished it (non-outstanding transfer: one at a time).
  task send(dut_axi_txn t);
    if (t.is_write) begin
      dut_vip_write_seq s = dut_vip_write_seq::type_id::create("wr");
      s.t = t;
      s.start(vip_agent.axi4_master_write_seqr_h);
    end else begin
      dut_vip_read_seq s = dut_vip_read_seq::type_id::create("rd");
      s.t = t;
      s.start(vip_agent.axi4_master_read_seqr_h);
    end
  endtask
endclass
