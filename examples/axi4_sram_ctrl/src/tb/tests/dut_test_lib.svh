// TC-002 | REQ-014, REQ-020, REQ-022 | directed, later
class dut_tc_002_incr_bursts_test extends dut_base_test;
  `uvm_component_utils(dut_tc_002_incr_bursts_test)
  function new(string name, uvm_component parent);
    super.new(name, parent);
    tc_id = "TC-002";
    rules.push_back("SBR-001");
    rules.push_back("SBR-004");
  endfunction
  task run_phase(uvm_phase phase);
    // DV_REGION(test.TC-002) BEGIN agent
    dut_axi_txn t;
    int unsigned lens[6] = '{0, 1, 3, 7, 15, 31};
    phase.raise_objection(this);
    wait_reset_release();
    foreach (lens[k]) begin
      t = dut_axi_txn::type_id::create($sformatf("incr_wr_%0d", k));
      t.is_write = 1'b1; t.id = k + 1; t.addr = 'h1000 + k * 'h400; t.len = lens[k][7:0]; t.size = 3'd2; t.burst = 2'b01;
      for (int b = 0; b <= lens[k]; b++) begin
        t.data.push_back(32'hC0DE0000 + (k << 8) + b);
        t.strb.push_back('1);
      end
      env.axi_adapter.send(t);
      t = dut_axi_txn::type_id::create($sformatf("incr_rd_%0d", k));
      t.is_write = 1'b0; t.id = k + 8; t.addr = 'h1000 + k * 'h400; t.len = lens[k][7:0]; t.size = 3'd2; t.burst = 2'b01;
      env.axi_adapter.send(t);
    end
    phase.drop_objection(this);
    // DV_REGION(test.TC-002) END
  endtask
endclass

