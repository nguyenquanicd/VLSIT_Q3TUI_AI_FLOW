// TC-004 | REQ-021 | directed, later
class dut_tc_004_wrap_bursts_test extends dut_base_test;
  `uvm_component_utils(dut_tc_004_wrap_bursts_test)
  function new(string name, uvm_component parent);
    super.new(name, parent);
    tc_id = "TC-004";
    rules.push_back("SBR-004");
  endfunction
  task run_phase(uvm_phase phase);
    // DV_REGION(test.TC-004) BEGIN agent
    dut_axi_txn t;
    int unsigned lens[4] = '{1, 3, 7, 15};
    int unsigned win;
    phase.raise_objection(this);
    wait_reset_release();
    foreach (lens[k]) begin
      win = (lens[k] + 1) * 4;
      // start inside the wrap window, word aligned, not at the window base
      t = dut_axi_txn::type_id::create($sformatf("wrap_wr_%0d", k));
      t.is_write = 1'b1; t.id = k + 1; t.addr = 'h3000 + k * 'h100 + win / 2 + 4; t.len = lens[k][7:0]; t.size = 3'd2; t.burst = 2'b10;
      for (int b = 0; b <= lens[k]; b++) begin
        t.data.push_back(32'hA7A70000 + (k << 8) + b);
        t.strb.push_back('1);
      end
      env.axi_adapter.send(t);
      t = dut_axi_txn::type_id::create($sformatf("wrap_rd_%0d", k));
      t.is_write = 1'b0; t.id = k + 5; t.addr = 'h3000 + k * 'h100 + win / 2 + 4; t.len = lens[k][7:0]; t.size = 3'd2; t.burst = 2'b10;
      env.axi_adapter.send(t);
      // read the whole window linearly from its base (INCR) to expose the wrapped writes
      t = dut_axi_txn::type_id::create($sformatf("wrap_lin_%0d", k));
      t.is_write = 1'b0; t.id = k + 9; t.addr = 'h3000 + k * 'h100; t.len = lens[k][7:0]; t.size = 3'd2; t.burst = 2'b01;
      env.axi_adapter.send(t);
    end
    phase.drop_objection(this);
    // DV_REGION(test.TC-004) END
  endtask
endclass

// TC-005 | REQ-024, REQ-025 | directed, later
class dut_tc_005_narrow_and_strobes_test extends dut_base_test;
  `uvm_component_utils(dut_tc_005_narrow_and_strobes_test)
  function new(string name, uvm_component parent);
    super.new(name, parent);
    tc_id = "TC-005";
    rules.push_back("SBR-001");
  endfunction
  task run_phase(uvm_phase phase);
    // DV_REGION(test.TC-005) BEGIN agent
    dut_axi_txn t;
    phase.raise_objection(this);
    wait_reset_release();
    // full-word write to initialise the area
    t = dut_axi_txn::type_id::create("init");
    t.is_write = 1'b1; t.id = 1; t.addr = 'h5000; t.len = 8'd3; t.size = 3'd2; t.burst = 2'b01;
    for (int b = 0; b < 4; b++) begin t.data.push_back(32'h11111111 * (b + 1)); t.strb.push_back('1); end
    env.axi_adapter.send(t);
    // 1-byte transfers, INCR, one lane per beat
    t = dut_axi_txn::type_id::create("n8_wr");
    t.is_write = 1'b1; t.id = 2; t.addr = 'h5001; t.len = 8'd3; t.size = 3'd0; t.burst = 2'b01;
    t.data.push_back(32'hAABBCCDD); t.strb.push_back(4'b0010);
    t.data.push_back(32'h99887766); t.strb.push_back(4'b0100);
    t.data.push_back(32'h55443322); t.strb.push_back(4'b1000);
    t.data.push_back(32'h01234567); t.strb.push_back(4'b0001);
    env.axi_adapter.send(t);
    t = dut_axi_txn::type_id::create("n8_rd");
    t.is_write = 1'b0; t.id = 3; t.addr = 'h5001; t.len = 8'd3; t.size = 3'd0; t.burst = 2'b01;
    env.axi_adapter.send(t);
    // 2-byte transfers
    t = dut_axi_txn::type_id::create("n16_wr");
    t.is_write = 1'b1; t.id = 4; t.addr = 'h5102; t.len = 8'd3; t.size = 3'd1; t.burst = 2'b01;
    t.data.push_back(32'hDEAD1111); t.strb.push_back(4'b1100);
    t.data.push_back(32'h2222BEEF); t.strb.push_back(4'b0011);
    t.data.push_back(32'hCAFE3333); t.strb.push_back(4'b1100);
    t.data.push_back(32'h4444F00D); t.strb.push_back(4'b0001);
    env.axi_adapter.send(t);
    t = dut_axi_txn::type_id::create("n16_rd");
    t.is_write = 1'b0; t.id = 5; t.addr = 'h5102; t.len = 8'd3; t.size = 3'd1; t.burst = 2'b01;
    env.axi_adapter.send(t);
    // full-width transfers with sparse strobes
    t = dut_axi_txn::type_id::create("sparse_wr");
    t.is_write = 1'b1; t.id = 6; t.addr = 'h5200; t.len = 8'd3; t.size = 3'd2; t.burst = 2'b01;
    t.data.push_back(32'hFFFFFFFF); t.strb.push_back(4'b0101);
    t.data.push_back(32'hEEEEEEEE); t.strb.push_back(4'b1010);
    t.data.push_back(32'hDDDDDDDD); t.strb.push_back(4'b0000);
    t.data.push_back(32'hCCCCCCCC); t.strb.push_back(4'b1001);
    env.axi_adapter.send(t);
    t = dut_axi_txn::type_id::create("sparse_rd");
    t.is_write = 1'b0; t.id = 7; t.addr = 'h5200; t.len = 8'd3; t.size = 3'd2; t.burst = 2'b01;
    env.axi_adapter.send(t);
    // linear read of the initialised area
    t = dut_axi_txn::type_id::create("init_rd");
    t.is_write = 1'b0; t.id = 8; t.addr = 'h5000; t.len = 8'd3; t.size = 3'd2; t.burst = 2'b01;
    env.axi_adapter.send(t);
    phase.drop_objection(this);
    // DV_REGION(test.TC-005) END
  endtask
endclass

// TC-006 | REQ-013, REQ-026, REQ-027, REQ-028 | negative, later
class dut_tc_006_error_bursts_test extends dut_base_test;
  `uvm_component_utils(dut_tc_006_error_bursts_test)
  function new(string name, uvm_component parent);
    super.new(name, parent);
    tc_id = "TC-006";
    rules.push_back("SBR-005");
  endfunction
  task run_phase(uvm_phase phase);
    // DV_REGION(test.TC-006) BEGIN agent
    dut_axi_txn t;
    phase.raise_objection(this);
    wait_reset_release();
    // known contents
    t = dut_axi_txn::type_id::create("init");
    t.is_write = 1'b1; t.id = 1; t.addr = 'h7000; t.len = 8'd7; t.size = 3'd2; t.burst = 2'b01;
    for (int b = 0; b < 8; b++) begin t.data.push_back(32'h5A5A0000 + b); t.strb.push_back('1); end
    env.axi_adapter.send(t);
    // write with AxSIZE above max (aligned address): SLVERR, memory unchanged
    t = dut_axi_txn::type_id::create("wr_bigsize");
    t.is_write = 1'b1; t.id = 2; t.addr = 'h7000; t.len = 8'd1; t.size = 3'd3; t.burst = 2'b01;
    for (int b = 0; b < 2; b++) begin t.data.push_back(32'hBAD00000 + b); t.strb.push_back('1); end
    env.axi_adapter.send(t);
    // write with misaligned address
    t = dut_axi_txn::type_id::create("wr_misal");
    t.is_write = 1'b1; t.id = 3; t.addr = 'h7012; t.len = 8'd2; t.size = 3'd2; t.burst = 2'b01;
    for (int b = 0; b < 3; b++) begin t.data.push_back(32'hBAD10000 + b); t.strb.push_back('1); end
    env.axi_adapter.send(t);
    // read back: contents must be unchanged
    t = dut_axi_txn::type_id::create("rd_check");
    t.is_write = 1'b0; t.id = 4; t.addr = 'h7000; t.len = 8'd7; t.size = 3'd2; t.burst = 2'b01;
    env.axi_adapter.send(t);
    // read with AxSIZE above max
    t = dut_axi_txn::type_id::create("rd_bigsize");
    t.is_write = 1'b0; t.id = 5; t.addr = 'h7000; t.len = 8'd3; t.size = 3'd3; t.burst = 2'b01;
    env.axi_adapter.send(t);
    // read with misaligned address
    t = dut_axi_txn::type_id::create("rd_misal");
    t.is_write = 1'b0; t.id = 6; t.addr = 'h7006; t.len = 8'd2; t.size = 3'd2; t.burst = 2'b01;
    env.axi_adapter.send(t);
    // following aligned bursts return OKAY
    t = dut_axi_txn::type_id::create("ok_wr");
    t.is_write = 1'b1; t.id = 7; t.addr = 'h7100; t.len = 8'd3; t.size = 3'd2; t.burst = 2'b01;
    for (int b = 0; b < 4; b++) begin t.data.push_back(32'h600D0000 + b); t.strb.push_back('1); end
    env.axi_adapter.send(t);
    t = dut_axi_txn::type_id::create("ok_rd");
    t.is_write = 1'b0; t.id = 8; t.addr = 'h7100; t.len = 8'd3; t.size = 3'd2; t.burst = 2'b01;
    env.axi_adapter.send(t);
    phase.drop_objection(this);
    // DV_REGION(test.TC-006) END
  endtask
endclass

// TC-007 | REQ-011, REQ-012, REQ-050, REQ-009, REQ-010 | directed, later
class dut_tc_007_backpressure_test extends dut_base_test;
  `uvm_component_utils(dut_tc_007_backpressure_test)
  function new(string name, uvm_component parent);
    super.new(name, parent);
    tc_id = "TC-007";
    rules.push_back("SBR-006");
  endfunction
  task run_phase(uvm_phase phase);
    // DV_REGION(test.TC-007) BEGIN agent
    dut_axi_txn t;
    // Note: i_bready/i_rready are driven by the VIP master (the test has no access to those pins),
    // so back-to-back long bursts are issued to load the FIFOs; the enabled rule SBR-006 checks the
    // stability, ready and overflow behavior on the pins. Explicit ready hold-off is not stimulated.
    phase.raise_objection(this);
    wait_reset_release();
    for (int k = 0; k < 6; k++) begin
      t = dut_axi_txn::type_id::create($sformatf("bp_wr_%0d", k));
      t.is_write = 1'b1; t.id = k + 1; t.addr = 'h6000 + k * 'h100; t.len = 8'd15; t.size = 3'd2; t.burst = 2'b01;
      for (int b = 0; b < 16; b++) begin t.data.push_back(32'hB0000000 + (k << 8) + b); t.strb.push_back('1); end
      env.axi_adapter.send(t);
    end
    for (int k = 0; k < 6; k++) begin
      t = dut_axi_txn::type_id::create($sformatf("bp_rd_%0d", k));
      t.is_write = 1'b0; t.id = k + 1; t.addr = 'h6000 + k * 'h100; t.len = 8'd15; t.size = 3'd2; t.burst = 2'b01;
      env.axi_adapter.send(t);
    end
    phase.drop_objection(this);
    // DV_REGION(test.TC-007) END
  endtask
endclass

// TC-008 | REQ-029 | directed, later
class dut_tc_008_id_ordering_test extends dut_base_test;
  `uvm_component_utils(dut_tc_008_id_ordering_test)
  function new(string name, uvm_component parent);
    super.new(name, parent);
    tc_id = "TC-008";
    rules.push_back("SBR-002");
    rules.push_back("SBR-003");
  endfunction
  task run_phase(uvm_phase phase);
    // DV_REGION(test.TC-008) BEGIN agent
    dut_axi_txn t;
    int unsigned ids[8] = '{5, 5, 5, 0, 7, 3, 3, 15};
    phase.raise_objection(this);
    wait_reset_release();
    env.scb.enable("SBR-001");   // SBR-003 predicts read data from the memory model that SBR-001 maintains
    // writes with reused and distinct IDs, different lengths
    foreach (ids[k]) begin
      t = dut_axi_txn::type_id::create($sformatf("id_wr_%0d", k));
      t.is_write = 1'b1; t.id = ids[k]; t.addr = 'h800 + k * 'h40; t.len = k[7:0] % 4; t.size = 3'd2; t.burst = 2'b01;
      for (int b = 0; b <= t.len; b++) begin
        t.data.push_back(32'h1D000000 + (k << 8) + b);
        t.strb.push_back('1);
      end
      env.axi_adapter.send(t);
    end
    foreach (ids[k]) begin
      t = dut_axi_txn::type_id::create($sformatf("id_rd_%0d", k));
      t.is_write = 1'b0; t.id = ids[k]; t.addr = 'h800 + k * 'h40; t.len = k[7:0] % 4; t.size = 3'd2; t.burst = 2'b01;
      env.axi_adapter.send(t);
    end
    phase.drop_objection(this);
    // DV_REGION(test.TC-008) END
  endtask
endclass

// TC-009 | REQ-022 | directed, later
class dut_tc_009_max_length_bursts_test extends dut_base_test;
  `uvm_component_utils(dut_tc_009_max_length_bursts_test)
  function new(string name, uvm_component parent);
