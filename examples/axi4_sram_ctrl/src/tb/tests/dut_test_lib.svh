// TC-010 | REQ-019, REQ-040, REQ-050, REQ-029, REQ-014 | random, later
class dut_tc_010_random_mixed_test extends dut_base_test;
  `uvm_component_utils(dut_tc_010_random_mixed_test)
  function new(string name, uvm_component parent);
    super.new(name, parent);
    tc_id = "TC-010";
    rules.push_back("SBR-001");
    rules.push_back("SBR-002");
    rules.push_back("SBR-003");
    rules.push_back("SBR-006");
    rules.push_back("SBR-008");
  endfunction
  task run_phase(uvm_phase phase);
    // DV_REGION(test.TC-010) BEGIN agent
    dut_axi_txn t;
    int unsigned n_len;
    int unsigned n_id;
    int unsigned n_off;
    phase.raise_objection(this);
    wait_reset_release();
    // initialise the region that is read concurrently later
    for (int k = 0; k < 8; k++) begin
      t = dut_axi_txn::type_id::create($sformatf("init_wr_%0d", k));
      t.is_write = 1'b1; t.id = k; t.addr = 'h8000 + k * 'h100; t.len = 8'd7; t.size = 3'd2; t.burst = 2'b01;
      for (int b = 0; b < 8; b++) begin
        t.data.push_back(32'h7E570000 + (k << 8) + b);
        t.strb.push_back('1);
      end
      env.axi_adapter.send(t);
    end
    // concurrent independent write and read streams on disjoint regions
    fork
      begin : wr_thread
        dut_axi_txn w;
        int unsigned l, i;
        for (int k = 0; k < 20; k++) begin
          void'(std::randomize(l) with { l inside {[0:15]}; });
          void'(std::randomize(i) with { i inside {[0:15]}; });
          w = dut_axi_txn::type_id::create($sformatf("rnd_wr_%0d", k));
          w.is_write = 1'b1; w.id = i; w.addr = 'h9000 + k * 'h100; w.len = l[7:0]; w.size = 3'd2; w.burst = 2'b01;
          for (int b = 0; b <= l; b++) begin
            w.data.push_back(32'hAD000000 + (k << 8) + b);
            w.strb.push_back('1);
          end
          env.axi_adapter.send(w);
        end
      end
      begin : rd_thread
        dut_axi_txn r;
        int unsigned i, o;
        for (int k = 0; k < 20; k++) begin
          void'(std::randomize(i) with { i inside {[0:15]}; });
          void'(std::randomize(o) with { o inside {[0:7]}; });
          r = dut_axi_txn::type_id::create($sformatf("rnd_rd_%0d", k));
          r.is_write = 1'b0; r.id = i; r.addr = 'h8000 + o * 'h100; r.len = 8'd7; r.size = 3'd2; r.burst = 2'b01;
          env.axi_adapter.send(r);
        end
      end
    join
    phase.drop_objection(this);
    // DV_REGION(test.TC-010) END
  endtask
endclass

// TC-011 | REQ-052, REQ-053, REQ-054, REQ-055, REQ-056, REQ-057, REQ-018 | directed, later
class dut_tc_011_timing_latency_test extends dut_base_test;
  `uvm_component_utils(dut_tc_011_timing_latency_test)
  function new(string name, uvm_component parent);
    super.new(name, parent);
    tc_id = "TC-011";
    rules.push_back("SBR-007");
    rules.push_back("SBR-008");
  endfunction
  task run_phase(uvm_phase phase);
    // DV_REGION(test.TC-011) BEGIN agent
    dut_axi_txn t;
    phase.raise_objection(this);
    wait_reset_release();
    // single-beat write and read (minimum latency c3 / c4), checked by the enabled rule
    t = dut_axi_txn::type_id::create("lat_wr");
    t.is_write = 1'b1; t.id = 1; t.addr = 'hA00; t.len = 8'd0; t.size = 3'd2; t.burst = 2'b01;
    t.data.push_back(32'h11AA55EE); t.strb.push_back('1);
    env.axi_adapter.send(t);
    t = dut_axi_txn::type_id::create("lat_rd");
    t.is_write = 1'b0; t.id = 2; t.addr = 'hA00; t.len = 8'd0; t.size = 3'd2; t.burst = 2'b01;
    env.axi_adapter.send(t);
    // multi-beat burst for write rate 1 and read rate 0.5
    t = dut_axi_txn::type_id::create("rate_wr");
    t.is_write = 1'b1; t.id = 3; t.addr = 'hB00; t.len = 8'd15; t.size = 3'd2; t.burst = 2'b01;
    for (int b = 0; b < 16; b++) begin t.data.push_back(32'h22000000 + b); t.strb.push_back('1); end
    env.axi_adapter.send(t);
    t = dut_axi_txn::type_id::create("rate_rd");
    t.is_write = 1'b0; t.id = 4; t.addr = 'hB00; t.len = 8'd15; t.size = 3'd2; t.burst = 2'b01;
    env.axi_adapter.send(t);
    // back-to-back bursts for the AxREADY interval
    for (int k = 0; k < 4; k++) begin
      t = dut_axi_txn::type_id::create($sformatf("b2b_wr_%0d", k));
      t.is_write = 1'b1; t.id = k; t.addr = 'hC00 + k * 'h40; t.len = 8'd3; t.size = 3'd2; t.burst = 2'b01;
      for (int b = 0; b < 4; b++) begin t.data.push_back(32'h33000000 + (k << 8) + b); t.strb.push_back('1); end
      env.axi_adapter.send(t);
    end
    for (int k = 0; k < 4; k++) begin
      t = dut_axi_txn::type_id::create($sformatf("b2b_rd_%0d", k));
      t.is_write = 1'b0; t.id = k; t.addr = 'hC00 + k * 'h40; t.len = 8'd3; t.size = 3'd2; t.burst = 2'b01;
      env.axi_adapter.send(t);
    end
    phase.drop_objection(this);
    // DV_REGION(test.TC-011) END
  endtask
endclass

// TC-012 | REQ-020 | directed, later
class dut_tc_012_incr_cross_4kb_test extends dut_base_test;
  `uvm_component_utils(dut_tc_012_incr_cross_4kb_test)
  function new(string name, uvm_component parent);
    super.new(name, parent);
    tc_id = "TC-012";
    rules.push_back("SBR-004");
    rules.push_back("SBR-001");
  endfunction
  task run_phase(uvm_phase phase);
    // DV_REGION(test.TC-012) BEGIN agent
    dut_axi_txn t;
    int unsigned lens[3] = '{3, 7, 15};
    phase.raise_objection(this);
    wait_reset_release();
    // each burst starts below a 4 KB boundary and crosses it
    foreach (lens[k]) begin
      t = dut_axi_txn::type_id::create($sformatf("x4k_wr_%0d", k));
      t.is_write = 1'b1; t.id = k + 1; t.addr = (k + 1) * 'h1000 - 8; t.len = lens[k][7:0]; t.size = 3'd2; t.burst = 2'b01;
      for (int b = 0; b <= lens[k]; b++) begin
        t.data.push_back(32'h4B000000 + (k << 8) + b);
        t.strb.push_back('1);
      end
      env.axi_adapter.send(t);
      t = dut_axi_txn::type_id::create($sformatf("x4k_rd_%0d", k));
      t.is_write = 1'b0; t.id = k + 5; t.addr = (k + 1) * 'h1000 - 8; t.len = lens[k][7:0]; t.size = 3'd2; t.burst = 2'b01;
      env.axi_adapter.send(t);
    end
    phase.drop_objection(this);
    // DV_REGION(test.TC-012) END
  endtask
endclass
