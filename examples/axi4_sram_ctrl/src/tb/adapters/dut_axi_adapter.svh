// VIP adapter.
// Code between `DV_REGION(id) BEGIN scaffold` and `END` is generated; change BEGIN scaffold to BEGIN agent / BEGIN user
// when you implement it: such a region is kept when the scaffold is regenerated.
// The VIP adapter: the single place that knows the VIP (axi4_master_agent). The rest of the testbench sees dut_axi_txn and `send` only.
class dut_vip_write_seq extends uvm_sequence #(axi4_master_pkg::axi4_master_tx);
  `uvm_object_utils(dut_vip_write_seq)
  dut_axi_txn t;
  function new(string name = "dut_vip_write_seq");
    super.new(name);
  endfunction
  task body();
    axi4_master_pkg::axi4_master_tx req = axi4_master_pkg::axi4_master_tx::type_id::create("req");
    start_item(req);
    req.tx_type       = axi4_globals_pkg::WRITE;
    req.transfer_type = axi4_globals_pkg::NON_OUTSTANDING_WRITE;
    void'($cast(req.awid, t.id));
    req.awaddr = t.addr;
    req.awlen  = t.len;
    void'($cast(req.awsize, t.size));
    void'($cast(req.awburst, t.burst));
    req.wdata = {};
    req.wstrb = {};
    foreach (t.data[i]) req.wdata.push_back(t.data[i]);
    foreach (t.strb[i]) req.wstrb.push_back(t.strb[i]);
    req.no_of_wait_states = 0;
    finish_item(req);
  endtask
endclass

