// TC-001 | REQ-001, REQ-003, REQ-004, REQ-005, REQ-006, REQ-007, REQ-008, REQ-014, REQ-045, REQ-047, REQ-048
// Reset, then one aligned single-beat INCR write and a read back of the same location. Relies on SBR-001, SBR-002, SBR-003, SBR-008.
class dut_smoke_vseq extends dut_base_seq;
  `uvm_object_utils(dut_smoke_vseq)
