// DV_SCAFFOLD: generated by Q3TUI (uvm_vip backend) from the verification contract 3d3d7bc64241.
// Project: axi4_sram_ctrl | Author: project engineer (user) | AI flow: VLSIT Q3TUI | Date: 2026-10-19
// AXI transaction (VIP independent).
// Code between `DV_REGION(id) BEGIN scaffold` and `END` is generated; change BEGIN scaffold to BEGIN agent / BEGIN user
// when you implement it: such a region is kept when the scaffold is regenerated.
// VIP-independent AXI transaction: what the scoreboard and coverage see. The adapter fills it from the VIP's own transaction (DUT-DV-019).
class dut_axi_txn extends uvm_sequence_item;
  `uvm_object_utils(dut_axi_txn)
  bit                         is_write;
  bit [PARA_ID_WD-1:0]          id;
  bit [PARA_ADDR_WD-1:0]        addr;
  bit [7:0]                   len;     // beats - 1
  bit [2:0]                   size;
  bit [1:0]                   burst;
  bit [PARA_DATA_WD-1:0]        data[$];
  bit [(PARA_DATA_WD/8)-1:0]    strb[$];
  bit [1:0]                   resp[$]; // B: one entry; R: one per beat
  bit                         last_seen;
  bit                         incomplete;  // the response came before every data beat was seen / the beat count differs from len + 1
  time                        t_addr;      // time of the address handshake
  time                        t_done;      // time of the last data beat (read) or of the response (write)
  function new(string name = "dut_axi_txn");
    super.new(name);
  endfunction
  function string convert2string();
    return $sformatf("%s id=%0h addr=%0h len=%0d size=%0d burst=%0d beats=%0d", is_write ? "WR" : "RD", id, addr, len, size, burst, data.size());
  endfunction
endclass

// One SRAM-side access seen on the memory interface of the DUT.
class dut_sram_txn extends uvm_sequence_item;
  `uvm_object_utils(dut_sram_txn)
  int unsigned                bank;
  bit                         we;      // write enable seen in this cycle
  bit                         oe;      // read (output) enable seen in this cycle
  bit                         is_write;
  bit [PARA_ADDR_WD-1:0]        addr;
  bit [PARA_DATA_WD-1:0]        data;    // write data, or the word returned in the following cycle
  bit [(PARA_DATA_WD/8)-1:0]    strb;
  function new(string name = "dut_sram_txn");
    super.new(name);
  endfunction
  function string convert2string();
    return $sformatf("bank=%0d we=%0b oe=%0b addr=%0h data=%0h strb=%0h", bank, we, oe, addr, data, strb);
  endfunction
endclass
