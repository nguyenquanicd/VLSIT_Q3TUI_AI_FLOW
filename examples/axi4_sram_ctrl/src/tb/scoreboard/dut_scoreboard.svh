    super.new(name, parent);
  endfunction
  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    axi_imp = new("axi_imp", this);
    sram_imp = new("sram_imp", this);
  endfunction
  function void enable(string rule_id);
    enabled[rule_id] = 1;
  endfunction
  function void write_axi(dut_axi_txn t);
    if (enabled.exists("SBR-001")) check_sbr_001(t);
    if (enabled.exists("SBR-002")) check_sbr_002(t);
    if (enabled.exists("SBR-003")) check_sbr_003(t);
    if (enabled.exists("SBR-004")) check_sbr_004(t);
    if (enabled.exists("SBR-005")) check_sbr_005(t);
    if (enabled.exists("SBR-006")) check_sbr_006(t);
    if (enabled.exists("SBR-007")) check_sbr_007(t);
    if (enabled.exists("SBR-008")) check_sbr_008(t);
    if (enabled.exists("SBR-009")) check_sbr_009(t);
  endfunction
  function void write_sram(dut_sram_txn s);
    if (enabled.exists("SBR-001")) sram_sbr_001(s);
    if (enabled.exists("SBR-003")) sram_sbr_003(s);
    if (enabled.exists("SBR-005")) sram_sbr_005(s);
    if (enabled.exists("SBR-007")) sram_sbr_007(s);
    if (enabled.exists("SBR-008")) sram_sbr_008(s);
    if (enabled.exists("SBR-009")) sram_sbr_009(s);
  endfunction
  function void mismatch(string rule, string msg);
    mismatches++;
    `uvm_error(rule, msg)
  endfunction
  // SBR-001 | REQ-024, REQ-025, REQ-045, REQ-017 | spec §4 narrow transfers and write issue
  // Byte-addressed memory model: a write beat updates only the byte lanes selected by WSTRB of the full word; a read returns the full word; the low BYTE_LSB bits are ignored.
  function void check_sbr_001(dut_axi_txn t);
    // DV_REGION(SBR-001) BEGIN agent
    int unsigned nbytes;
    int unsigned nb;
    bit [PARA_ADDR_WD-1:0] a;
    bit [PARA_ADDR_WD-1:0] wb;
    bit [PARA_ADDR_WD-1:0] lower;
    bit [PARA_ADDR_WD-1:0] cont;
    bit [PARA_ADDR_WD-1:0] lsb_mask;
    if (!t.is_write) return;
    lsb_mask = PARA_DATA_WD/8 - 1;
    nb = int'(t.len) + 1;
    checks++;
    if (t.data.size() != nb || t.strb.size() != nb) begin
      mismatch("SBR-001", $sformatf("write %s: data/strb beat count (%0d/%0d) differs from len+1 = %0d; memory model not updated", t.convert2string(), t.data.size(), t.strb.size(), nb));
      return;
    end
    // a write answered with SLVERR leaves the memory unmodified
    if (t.resp.size() >= 1 && t.resp[0] == 2'b10) return;
    nbytes = 1 << t.size;
    cont = nbytes * nb;
    a = t.addr;
    for (int i = 0; i < nb; i++) begin
      wb = a & ~lsb_mask;   // the low BYTE_LSB address bits are ignored by the memory
      for (int b = 0; b < PARA_DATA_WD/8; b++)
        if (t.strb[i][b]) exp_mem[wb + b] = t.data[i][8*b +: 8];
      case (t.burst)
        2'b00: a = a;
        2'b10: begin
          lower = a & ~(cont - 1);
          a = a + nbytes;
          if (a >= lower + cont) a = lower;
        end
        default: a = a + nbytes;
      endcase
    end
    // DV_REGION(SBR-001) END
  endfunction

  // SBR-001 (memory side): called for every SRAM access the monitor observes
  function void sram_sbr_001(dut_sram_txn s);
    // DV_REGION(SBR-001.sram) BEGIN agent
    // No separate check: exp_mem is built from AXI-level write bursts in check_sbr_001.
    // Nothing is counted here because no check is made.
    // DV_REGION(SBR-001.sram) END
  endfunction

  // SBR-002 | REQ-014, REQ-013, REQ-046, REQ-029 | spec §4 response generation
  // Exactly one B response per accepted AW burst, with the AWID, in AW order; BRESP is OKAY or SLVERR only.
  function void check_sbr_002(dut_axi_txn t);
    // DV_REGION(SBR-002) BEGIN agent
    if (!t.is_write) return;
    checks++;
    if (t.resp.size() != 1)
      mismatch("SBR-002", $sformatf("expected exactly one B response per AW burst, got %0d: %s", t.resp.size(), t.convert2string()));
    else begin
      checks++;
      if (!(t.resp[0] == 2'b00 || t.resp[0] == 2'b10))
        mismatch("SBR-002", $sformatf("BRESP %b is neither OKAY (00) nor SLVERR (10): %s", t.resp[0], t.convert2string()));
    end
    checks++;
    if (t.incomplete)
      mismatch("SBR-002", $sformatf("B response seen before all data beats / beat count differs from len+1: %s", t.convert2string()));
    // DV_REGION(SBR-002) END
  endfunction

  // SBR-003 | REQ-014, REQ-048, REQ-007, REQ-012, REQ-029 | spec §4 read path
  // Exactly AxLEN+1 R beats per accepted AR burst, in AR order, with the ARID, the memory data, and RLAST only on the last beat.
  function void check_sbr_003(dut_axi_txn t);
    // DV_REGION(SBR-003) BEGIN agent
    int unsigned nbytes;
    int unsigned nb;
    bit [PARA_ADDR_WD-1:0] a;
    bit [PARA_ADDR_WD-1:0] wb;
    bit [PARA_ADDR_WD-1:0] lower;
    bit [PARA_ADDR_WD-1:0] cont;
    bit [PARA_ADDR_WD-1:0] lsb_mask;
    bit [PARA_DATA_WD-1:0] exp_w;
    if (t.is_write) return;
    lsb_mask = PARA_DATA_WD/8 - 1;
    nb = int'(t.len) + 1;
    checks++;
    if (t.resp.size() != nb || t.data.size() != nb) begin
      mismatch("SBR-003", $sformatf("expected %0d R beats, got data=%0d resp=%0d: %s", nb, t.data.size(), t.resp.size(), t.convert2string()));
      return;
    end
    checks++;
    if (t.incomplete || !t.last_seen)
      mismatch("SBR-003", $sformatf("RLAST not exactly on the last beat (incomplete=%0b last_seen=%0b): %s", t.incomplete, t.last_seen, t.convert2string()));
    nbytes = 1 << t.size;
    cont = nbytes * nb;
    a = t.addr;
    for (int i = 0; i < nb; i++) begin
      checks++;
      if (!(t.resp[i] == 2'b00 || t.resp[i] == 2'b10))
        mismatch("SBR-003", $sformatf("RRESP %b of beat %0d is neither OKAY nor SLVERR: %s", t.resp[i], i, t.convert2string()));
      // data is only predicted for OKAY beats; the full word is returned
      if (t.resp[i] == 2'b00) begin
        wb = a & ~lsb_mask;
        for (int b = 0; b < PARA_DATA_WD/8; b++)
          exp_w[8*b +: 8] = exp_mem.exists(wb + b) ? exp_mem[wb + b] : 8'h00;
        checks++;
        if (t.data[i] !== exp_w)
          mismatch("SBR-003", $sformatf("beat %0d addr=%0h: RDATA %0h, expected %0h", i, a, t.data[i], exp_w));
      end
      case (t.burst)
        2'b00: a = a;
        2'b10: begin
          lower = a & ~(cont - 1);
          a = a + nbytes;
          if (a >= lower + cont) a = lower;
        end
        default: a = a + nbytes;
      endcase
    end
    // DV_REGION(SBR-003) END
  endfunction

