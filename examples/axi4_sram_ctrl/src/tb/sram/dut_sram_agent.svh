// Project: axi4_sram_ctrl | Author: project engineer (user) | AI flow: VLSIT Q3TUI | Date: 2026-10-19
// SRAM side agent.
// Code between `DV_REGION(id) BEGIN scaffold` and `END` is generated; change BEGIN scaffold to BEGIN agent / BEGIN user
// when you implement it: such a region is kept when the scaffold is regenerated.
// SRAM side of the DUT: a testbench memory model (responder) and a passive monitor. Behavior comes from the specification's SRAM
// obligations (interface section); the regions below are semantic work (see the worklist).
class dut_sram_monitor extends uvm_monitor;
  `uvm_component_utils(dut_sram_monitor)
  virtual dut_pins_if vif;
  uvm_analysis_port #(dut_sram_txn) ap;
  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction
  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    ap = new("ap", this);
    if (!uvm_config_db#(virtual dut_pins_if)::get(this, "", "pins_vif", vif)) `uvm_fatal("DUT_SRAM", "pins_vif is not set")
  endfunction
  task run_phase(uvm_phase phase);
    // DV_REGION(sram.monitor) BEGIN agent
    dut_sram_txn pend[PARA_NUM_BANKS];
    dut_sram_txn t;
    int unsigned k;
    localparam int unsigned BYTE_LSB_M = $clog2(PARA_DATA_WD/8);
    forever begin
      @(vif.mon_cb);
      if (vif.i_rst_n !== 1'b1) begin
        for (k = 0; k < PARA_NUM_BANKS; k++) pend[k] = null;
        continue;
      end
      for (k = 0; k < PARA_NUM_BANKS; k++) begin
        // a read issued in the previous cycle returns its word in this cycle
        if (pend[k] != null) begin
          pend[k].data = vif.mon_cb.i_sram_rdata[k];
          ap.write(pend[k]);
          pend[k] = null;
        end
        if (vif.mon_cb.o_sram_we[k] === 1'b1) begin
          t = dut_sram_txn::type_id::create($sformatf("sram_wr_b%0d", k));
          t.bank = k;
          t.we = 1'b1;
          t.oe = (vif.mon_cb.o_sram_oe[k] === 1'b1);
          t.is_write = 1'b1;
          t.addr = vif.mon_cb.o_sram_addr[k];
          t.data = vif.mon_cb.o_sram_wdata[k];
          t.strb = vif.mon_cb.o_sram_wstrb[k];
          ap.write(t);
        end else if (vif.mon_cb.o_sram_oe[k] === 1'b1) begin
          t = dut_sram_txn::type_id::create($sformatf("sram_rd_b%0d", k));
          t.bank = k;
          t.we = 1'b0;
          t.oe = 1'b1;
          t.is_write = 1'b0;
          t.addr = vif.mon_cb.o_sram_addr[k];
          t.strb = '0;
          pend[k] = t;
        end
      end
    end
    // DV_REGION(sram.monitor) END
  endtask
endclass

class dut_sram_responder extends uvm_component;
  `uvm_component_utils(dut_sram_responder)
  virtual dut_pins_if vif;
  bit [7:0] mem[bit [PARA_ADDR_WD-1:0]];   // byte-addressed memory of the model; a byte that was never written reads as 0 (a testbench choice, not a DUT requirement)
  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction
  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    if (!uvm_config_db#(virtual dut_pins_if)::get(this, "", "pins_vif", vif)) `uvm_fatal("DUT_SRAM", "pins_vif is not set")
  endfunction
  task run_phase(uvm_phase phase);
    // DV_REGION(sram.responder) BEGIN agent
    int unsigned k;
    int unsigned b;
    int unsigned nbytes;
    bit [PARA_ADDR_WD-1:0] base;
    bit [PARA_DATA_WD-1:0] word;
    bit [PARA_DATA_WD-1:0] rd[PARA_NUM_BANKS];
    localparam int unsigned BYTE_LSB_R = $clog2(PARA_DATA_WD/8);
    nbytes = PARA_DATA_WD/8;
    for (k = 0; k < PARA_NUM_BANKS; k++) vif.drv_cb.i_sram_rdata[k] <= '0;
    forever begin
      @(vif.mon_cb);
      for (k = 0; k < PARA_NUM_BANKS; k++) rd[k] = '0;
      if (vif.i_rst_n === 1'b1) begin
        for (k = 0; k < PARA_NUM_BANKS; k++) begin
          // write at the edge ending the cycle: only the byte lanes selected by wstrb change
          if (vif.mon_cb.o_sram_we[k] === 1'b1) begin
            base = vif.mon_cb.o_sram_addr[k];
            base[BYTE_LSB_R-1:0] = '0;
            for (b = 0; b < nbytes; b++) begin
              if (vif.mon_cb.o_sram_wstrb[k][b] === 1'b1)
                mem[base + b] = vif.mon_cb.o_sram_wdata[k][b*8 +: 8];
            end
          end
          // read: capture the word now, present it throughout the following cycle
          if (vif.mon_cb.o_sram_oe[k] === 1'b1) begin
            base = vif.mon_cb.o_sram_addr[k];
            base[BYTE_LSB_R-1:0] = '0;
            word = '0;
            for (b = 0; b < nbytes; b++) begin
              if (mem.exists(base + b)) word[b*8 +: 8] = mem[base + b];
            end
            rd[k] = word;
          end
        end
      end
      for (k = 0; k < PARA_NUM_BANKS; k++) vif.drv_cb.i_sram_rdata[k] <= rd[k];
    end
    // DV_REGION(sram.responder) END
  endtask
endclass

class dut_sram_agent extends uvm_agent;
  `uvm_component_utils(dut_sram_agent)
  dut_sram_monitor   mon;
  dut_sram_responder rsp;
  uvm_analysis_port #(dut_sram_txn) ap;
  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction
  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    mon = dut_sram_monitor::type_id::create("mon", this);
    rsp = dut_sram_responder::type_id::create("rsp", this);
    ap = new("ap", this);
  endfunction
  function void connect_phase(uvm_phase phase);
    mon.ap.connect(ap);
  endfunction
endclass
