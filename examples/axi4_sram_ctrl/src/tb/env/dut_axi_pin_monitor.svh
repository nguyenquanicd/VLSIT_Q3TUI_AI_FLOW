// DV_SCAFFOLD: generated by Q3TUI (uvm_vip backend) from the verification contract 3d3d7bc64241.
// Project: axi4_sram_ctrl | Author: project engineer (user) | AI flow: VLSIT Q3TUI | Date: 2026-10-19
// AXI4 monitor on the DUT pins (VIP independent).
// Code between `DV_REGION(id) BEGIN scaffold` and `END` is generated; change BEGIN scaffold to BEGIN agent / BEGIN user
// when you implement it: such a region is kept when the scaffold is regenerated.
class dut_axi_pin_monitor extends uvm_monitor;
  `uvm_component_utils(dut_axi_pin_monitor)
  virtual dut_pins_if vif;
  uvm_analysis_port #(dut_axi_txn) ap;
  dut_axi_txn aw_q[$];   // accepted write addresses, oldest first
  dut_axi_txn ar_q[$];   // accepted read addresses, oldest first
  bit [PARA_DATA_WD-1:0]     spare_data[$];  // write beats that arrived before their address
  bit [(PARA_DATA_WD/8)-1:0] spare_strb[$];
  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction
  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    ap = new("ap", this);
    if (!uvm_config_db#(virtual dut_pins_if)::get(this, "", "pins_vif", vif)) `uvm_fatal("DUT_AXI_MON", "pins_vif is not set")
  endfunction
  // the burst that takes the next write beat: the oldest accepted write whose beats are not complete
  function int next_write_burst();
    foreach (aw_q[i]) if (aw_q[i].data.size() < aw_q[i].len + 1) return i;
    return -1;
  endfunction
  function void give_write_beat(bit [PARA_DATA_WD-1:0] d, bit [(PARA_DATA_WD/8)-1:0] s);
    int i = next_write_burst();
    if (i < 0) begin
      spare_data.push_back(d);
      spare_strb.push_back(s);
    end else begin
      aw_q[i].data.push_back(d);
      aw_q[i].strb.push_back(s);
    end
  endfunction
  task run_phase(uvm_phase phase);
    forever begin
      @(vif.mon_cb);
      if (vif.i_rst_n !== 1'b1) begin  // reset: transactions in flight are discarded
        aw_q.delete(); ar_q.delete(); spare_data.delete(); spare_strb.delete();
        continue;
      end
      if (vif.mon_cb.i_awvalid === 1'b1 && vif.mon_cb.o_awready === 1'b1) begin
        dut_axi_txn t = dut_axi_txn::type_id::create("wr");
        t.is_write = 1; t.id = vif.mon_cb.i_awid; t.addr = vif.mon_cb.i_awaddr; t.len = vif.mon_cb.i_awlen; t.size = vif.mon_cb.i_awsize; t.burst = vif.mon_cb.i_awburst;
        t.t_addr = $time;
        aw_q.push_back(t);
        while (spare_data.size() != 0 && next_write_burst() >= 0) begin
          give_write_beat(spare_data.pop_front(), spare_strb.pop_front());
        end
      end
      if (vif.mon_cb.i_wvalid === 1'b1 && vif.mon_cb.o_wready === 1'b1) give_write_beat(vif.mon_cb.i_wdata, vif.mon_cb.i_wstrb);
      if (vif.mon_cb.o_bvalid === 1'b1 && vif.mon_cb.i_bready === 1'b1) begin
        foreach (aw_q[i]) if (aw_q[i].id == vif.mon_cb.o_bid) begin
          dut_axi_txn t = aw_q[i];
          aw_q.delete(i);
          t.resp.push_back(vif.mon_cb.o_bresp);
          t.incomplete = (t.data.size() != t.len + 1);
          t.t_done = $time;
          ap.write(t);
          break;
        end
      end
      if (vif.mon_cb.i_arvalid === 1'b1 && vif.mon_cb.o_arready === 1'b1) begin
        dut_axi_txn t = dut_axi_txn::type_id::create("rd");
        t.is_write = 0; t.id = vif.mon_cb.i_arid; t.addr = vif.mon_cb.i_araddr; t.len = vif.mon_cb.i_arlen; t.size = vif.mon_cb.i_arsize; t.burst = vif.mon_cb.i_arburst;
        t.t_addr = $time;
        ar_q.push_back(t);
      end
      if (vif.mon_cb.o_rvalid === 1'b1 && vif.mon_cb.i_rready === 1'b1) begin
        foreach (ar_q[i]) if (ar_q[i].id == vif.mon_cb.o_rid) begin
          dut_axi_txn t = ar_q[i];
          t.data.push_back(vif.mon_cb.o_rdata);
          t.resp.push_back(vif.mon_cb.o_rresp);
          if (vif.mon_cb.o_rlast === 1'b1) begin
            ar_q.delete(i);
            t.last_seen = 1;
            t.incomplete = (t.data.size() != t.len + 1);
            t.t_done = $time;
            ap.write(t);
          end
          break;
        end
      end
    end
  endtask
endclass
